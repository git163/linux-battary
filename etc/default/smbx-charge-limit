# 电量控制参数（smbx-charge-limit 读取；改完 sudo smbx restart）
#
# ---- 百分比粗档（主判据，抗负载）----
CAP=80                 # 电量 ≥ 此值 → 停充
RESUME=70              # 电量 ≤ 此值 → 恢复充电
SAFETY=40              # 安全线：低于此值无条件充电（不等确认、不看驻留时间）
CONFIRM=2              # 连续多少次采样条件一致才切换
INTERVAL=60            # 采样间隔（秒）

# ---- 最短驻留（秒；设 0 关闭）----
# 防止「刚充就停、刚停就充」的抖动：条件再怎么跳，状态也要保持够久。
# 配合 CONFIRM/INTERVAL，一次完整循环至少 10 分钟充电 + 10 分钟停充。
MIN_CHARGE_SEC=600     # 开始充电后至少充这么久才允许停
MIN_REST_SEC=600       # 停充后至少等这么久才允许恢复充电

# ---- 电压精调（微伏；设成 0 就退回纯百分比）----
# 注意：充电时端电压会被抬起来，实测从 4.132V → 4.200V（仅 270mA 充电电流），
# 所以停充阈值必须比"目标静置电压"高 80~100mV，否则会刚充几秒就停、来回抖。
VOLT_STOP=4220000      # 充电中端电压 ≥ 4.22V → 停充（对应静置约 4.13~4.15V ≈ 80%）
VOLT_RESUME=4030000    # 静置端电压 ≤ 4.03V → 恢复充电（对应约 70%）

# ---- 负载门槛（毫安，取绝对值）----
LOAD_QUIET=80          # ≤ 此值算静置，才允许用电压判"该恢复"
LOAD_FREEZE=300        # > 此值算重载，冻结判定（1A 负载 ≈ 120mV ≈ 10 个点，不可信）
