#!/bin/bash
# smbx-charge-limit —— 把电池电量控制在 RESUME%~CAP% 之间（默认 70~80%）
#   到 CAP 停充；掉到 RESUME 再放开；区间内不动（死区）；
#   且需连续 CONFIRM 次采样满足条件才切换，避免在阈值附近来回断电/充电。
#   低于 SAFETY 无条件充电（不等待确认）。
#   若 /run/smbx-drain.active 存在且未超时，仅做兜底，不干预 USB 输入。
set -u

PARAM_DIR=/sys/module/smbx_ctl/parameters
CHG=$PARAM_DIR/charging
USB=$PARAM_DIR/usb_input
BAT=/sys/class/power_supply/qcom-battery
CHARGER=/sys/class/power_supply/pm8150b-charger
DRAIN_FLAG=/run/smbx-drain.active
CONF=${CONF:-/etc/default/smbx-charge-limit}

# shellcheck source=/dev/null
[[ -r $CONF ]] && . "$CONF"

CAP=${CAP:-80}          # 上限：到这里停止充电
RESUME=${RESUME:-70}    # 下限：掉到这里恢复充电
SAFETY=${SAFETY:-40}    # 安全线：低于此值无条件充电
INTERVAL=${INTERVAL:-60}
CONFIRM=${CONFIRM:-2}   # 连续多少次采样满足条件才切换
DRAIN_MAX_AGE=${DRAIN_MAX_AGE:-43200}   # 放电模式最长 12h，超时强制恢复

log() { logger -t smbx-charge-limit -- "$*"; echo "$(date '+%F %T') $*"; }

# 模块不在（多半是内核升级后没重编）：只报一次，避免 systemd 反复重启刷日志
NO_MODULE=/run/smbx-charge-limit.no-module
if [[ ! -w $CHG || ! -w $USB ]]; then
	if [[ ! -f $NO_MODULE ]]; then
		log "smbx_ctl 模块未加载，暂停工作。重编后 systemctl restart smbx-charge-limit"
		log "  重建: sudo /opt/smbx-ctl/build.sh（或仓库里的 module/build.sh）"
		touch "$NO_MODULE"
	fi
	exit 1
fi
rm -f "$NO_MODULE"

log "启动：区间 ${RESUME}~${CAP}%（死区，连续 ${CONFIRM} 次确认才切换），安全线 ${SAFETY}%，采样 ${INTERVAL}s"

high_hits=0
low_hits=0
first_run=1

while :; do
	# 模块被卸载 / 内核升级后参数节点消失，退出让 systemd 拉起（只记录一次）
	if [[ ! -w $CHG ]]; then
		[[ -f $NO_MODULE ]] || {
			log "smbx_ctl 模块消失，退出等待重启"
			touch "$NO_MODULE"
		}
		exit 1
	fi

	cap=$(cat "$BAT/capacity" 2>/dev/null)
	if ! [[ ${cap:-} =~ ^[0-9]+$ ]]; then
		log "读不到电量，重试"
		sleep "$INTERVAL"
		continue
	fi

	# 连续命中计数：区间内清零，单次抖动不会触发切换
	if (( cap >= CAP )); then
		high_hits=$((high_hits + 1))
		low_hits=0
	elif (( cap <= RESUME )); then
		low_hits=$((low_hits + 1))
		high_hits=0
	else
		high_hits=0
		low_hits=0
	fi

	cur=$(cat "$CHG" 2>/dev/null)
	want=$cur
	reason=hold

	# 启动后的第一次采样直接按规则套用（不必等 CONFIRM 次），避免开机后
	# 满电状态下白白多充一两分钟；之后才走连续确认
	need=$CONFIRM
	(( first_run )) && need=1
	first_run=0

	if (( cap <= SAFETY )); then
		want=1; reason="低于安全线 ${SAFETY}%，无条件充电"
	elif (( high_hits >= need )); then
		want=0; reason="到达上限 ${CAP}%，停止充电"
	elif (( low_hits >= need )); then
		want=1; reason="到达下限 ${RESUME}%，恢复充电"
	fi

	if [[ $want != "$cur" ]]; then
		if echo "$want" >"$CHG"; then
			log "电量 ${cap}% → charging=$want（$reason）"
			high_hits=0
			low_hits=0
		else
			log "写 charging 失败"
		fi
	fi

	# ---- USB 输入兜底 ----
	usb=$(cat "$USB" 2>/dev/null)
	if (( cap <= RESUME )) && [[ $usb == 0 ]]; then
		echo 1 >"$USB" && log "电量 ${cap}% → 恢复 USB 输入（兜底）"
		rm -f "$DRAIN_FLAG"
	fi

	if [[ -f $DRAIN_FLAG ]]; then
		age=$(( $(date +%s) - $(stat -c %Y "$DRAIN_FLAG" 2>/dev/null || echo 0) ))
		if (( age > DRAIN_MAX_AGE )); then
			rm -f "$DRAIN_FLAG"
			echo 1 >"$USB"
			log "放电模式超过 $((DRAIN_MAX_AGE / 3600))h，强制恢复 USB 输入"
		fi
	fi

	sleep "$INTERVAL"
done
